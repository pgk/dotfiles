#!/usr/bin/env python3

"""Find orphan and sparsely-connected notes, and link communities with no hub, in a vault."""

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import notes_cluster
import notes_common


def note_entry(path, graph):
    return {
        "name": os.path.splitext(os.path.basename(path))[0],
        "path": path,
        "degree": len(graph[path]["neighbors"]),
        "broken_links": sorted(set(graph[path]["broken_links"])),
    }


def classify(graph, min_links):
    orphans = []
    sparse = []
    for path in graph:
        entry = note_entry(path, graph)
        if entry["degree"] == 0:
            orphans.append(entry)
        elif entry["degree"] < min_links:
            sparse.append(entry)
    def sort_key(entry):
        return (entry["degree"], entry["name"].lower())

    orphans.sort(key=sort_key)
    sparse.sort(key=sort_key)
    return orphans, sparse


def hubless_clusters(neighbors, labels, min_coverage, vault):
    """Clusters no note links to enough of to serve as their entry point."""
    hubless = []
    for entry in notes_cluster.cluster_entry_points(neighbors, labels):
        if entry["coverage"] >= min_coverage:
            continue
        path = entry["entry_point"]
        hubless.append(
            dict(
                entry,
                name=os.path.splitext(os.path.basename(path))[0],
                rel=os.path.relpath(path, vault),
            )
        )
    return hubless


def format_hubless(entries):
    printable = notes_common.printable
    lines = [f"Clusters without a hub ({len(entries)})"]
    for e in entries:
        lines.append(
            f"  cluster {e['cluster']}  [{e['size']} notes]  "
            f"no note reaches more than {e['reach']} of the other {e['others']}"
        )
        # Named, not ranked: in a ring every member ties, so this is the first of
        # several equals as often as it is a standout.
        lines.append(f"      best connected: {printable(e['name'])}  {printable(e['rel'])}")
    return lines


def format_group(title, entries, vault):
    printable = notes_common.printable
    lines = [f"{title} ({len(entries)})"]
    for e in entries:
        rel = printable(os.path.relpath(e["path"], vault))
        plural = "link" if e["degree"] == 1 else "links"
        line = f"  {printable(e['name'])}  [{e['degree']} {plural}]  {rel}"
        if e["broken_links"]:
            line += "  (broken: " + ", ".join(f"[[{printable(b)}]]" for b in e["broken_links"]) + ")"
        lines.append(line)
    return lines


def format_text(orphans, sparse, min_links, total, vault, hubless=(), shape=None):
    if not orphans and not sparse and not hubless:
        return f"All {total} notes in {vault} have at least {min_links} connection(s), and every cluster has a hub."
    lines = [f"Scanned {total} notes in {vault} (sparse threshold: < {min_links} connections)"]
    if shape:
        lines.append(notes_cluster.describe_shape(shape))
    if hubless:
        lines.append("")
        lines += format_hubless(hubless)
    if orphans:
        lines.append("")
        lines += format_group("Orphans", orphans, vault)
    if sparse:
        lines.append("")
        lines += format_group("Sparse", sparse, vault)
    return "\n".join(lines)


def format_json(orphans, sparse, min_links, total, vault, hubless=(), shape=None):
    return json.dumps(
        {
            "vault": vault,
            "min_links": min_links,
            "total_notes": total,
            "shape": shape,
            "hubless_clusters": list(hubless),
            "orphans": orphans,
            "sparse": sparse,
        },
        indent=2,
    )


def parse_args(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "vault",
        nargs="?",
        default=None,
        help="Path to the notes vault; required, or set $NOTES_VAULT",
    )
    parser.add_argument("-m", "--min-links", type=int, default=3, help="Notes below this connection count are 'sparse' (default: 3)")
    parser.add_argument(
        "--hub-reach",
        type=float,
        default=0.5,
        help="A cluster has a hub if one note links to at least this share of it; 0 < value <= 1 (default: 0.5)",
    )
    parser.add_argument("--json", action="store_true", help="Emit JSON instead of a text report")
    parser.add_argument(
        "--exclude",
        action="append",
        metavar="GLOB",
        default=None,
        help="Glob pattern, relative to vault, to exclude from the scan (repeatable)",
    )
    return parser.parse_args(argv)


def main(argv=None):
    args = parse_args(argv)
    try:
        if not 0 < args.hub_reach <= 1:
            raise ValueError(f"--hub-reach must be above 0 and at most 1, got {args.hub_reach}")
        vault_spec = notes_common.require_vault(args.vault)
    except ValueError as exc:
        print(f"notes-graph: {exc}", file=sys.stderr)
        return 1
    vault = os.path.abspath(os.path.expanduser(vault_spec))

    if not os.path.isdir(vault):
        print(f"notes-graph: not a directory: {vault}", file=sys.stderr)
        return 1

    files = list(notes_common.iter_markdown_files(vault, args.exclude or []))
    name_index = notes_common.build_name_index(files)
    graph = notes_cluster.build_graph(files, name_index)
    orphans, sparse = classify(graph, args.min_links)

    neighbors = notes_cluster.adjacency(graph)
    labels = notes_cluster.louvain(neighbors)
    shape = notes_cluster.shape(neighbors, labels)
    hubless = hubless_clusters(neighbors, labels, args.hub_reach, vault)

    if args.json:
        print(format_json(orphans, sparse, args.min_links, len(files), vault, hubless, shape))
    else:
        print(format_text(orphans, sparse, args.min_links, len(files), vault, hubless, shape))
    return 0


if __name__ == "__main__":
    sys.exit(main())
