#!/usr/bin/env python3

"""Find semantically similar but unlinked notes in a wikilink-based markdown vault."""

import argparse
import hashlib
import json
import math
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import notes_cluster
import notes_common
import notes_embed_cache
import notes_embed_client

EmbedUnavailable = notes_embed_cache.EmbedUnavailable
_printable = notes_common.printable
require_vault = notes_common.require_vault

MAX_CHARS = 8000
PREVIEW_CHARS = 60


def strip_frontmatter(text):
    if not text.startswith("---"):
        return text
    end = text.find("\n---", 3)
    if end == -1:
        return text
    rest = text[end + 4 :]
    return rest.split("\n", 1)[1] if "\n" in rest else ""


def note_text(name, raw):
    """The string actually embedded: note name, then body without frontmatter."""
    body = strip_frontmatter(raw).strip()
    text = f"{name}\n\n{body}" if body else name
    return text[:MAX_CHARS]


def content_hash(text):
    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:32]


def preview_of(text):
    """First non-empty body line, for picker rows. Assumes note_text() output."""
    lines = text.split("\n\n", 1)
    body = lines[1] if len(lines) > 1 else ""
    for line in body.split("\n"):
        stripped = line.strip()
        if stripped and not stripped.startswith("#"):
            if len(stripped) > PREVIEW_CHARS:
                return stripped[:PREVIEW_CHARS] + "…"
            return stripped
    return ""


def scan_vault(vault, excludes):
    """One pass per note: read it, hash the embed text, extract its wikilinks."""
    notes = []
    for path in notes_common.iter_markdown_files(vault, excludes):
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                raw = f.read()
        except OSError as exc:
            print(f"warning: skipping unreadable note {_printable(path)}: {_printable(exc)}", file=sys.stderr)
            continue
        name = os.path.splitext(os.path.basename(path))[0]
        text = note_text(name, raw)
        notes.append(
            {
                "name": name,
                "path": path,
                "hash": content_hash(text),
                "links": notes_common.extract_links(raw),
                "text": text,
            }
        )
    return notes


def linked_paths(target, notes, name_index):
    """Paths linked to the target in either direction."""
    linked = set()
    for link in target["links"]:
        path = notes_common.resolve_link(link, name_index)
        if path:
            linked.add(path)
    for note in notes:
        if note["path"] == target["path"]:
            continue
        for link in note["links"]:
            if notes_common.resolve_link(link, name_index) == target["path"]:
                linked.add(note["path"])
                break
    return linked


def find_similar(target, notes, cached, name_index, limit, include_linked, clusters=None, bridge_first=True):
    target_vec = cached.get((target["path"], target["hash"]))
    if target_vec is None:
        raise EmbedUnavailable(f"no embedding for target note: {_printable(target['name'])}")

    # Always computed: under --all it still labels each row, it just stops filtering.
    linked = linked_paths(target, notes, name_index)
    # No cluster data means no bridging signal, so every pair scores alike and
    # ranking falls back to similarity alone.
    clusters = clusters or {}
    target_cluster = clusters.get(target["path"])
    results = []
    for note in notes:
        if note["path"] == target["path"]:
            continue
        if note["path"] in linked and not include_linked:
            continue
        vec = cached.get((note["path"], note["hash"]))
        if vec is None:
            continue
        cluster = clusters.get(note["path"])
        results.append(
            {
                "name": note["name"],
                "path": note["path"],
                "score": round(math.sumprod(target_vec, vec), 4),
                "linked": note["path"] in linked,
                "crosses": cluster != target_cluster,
                "cluster": cluster,
                "preview": preview_of(note["text"]),
            }
        )
    # Cross-cluster pairs first: a link into a neighbourhood the target is already
    # part of adds little, while one that bridges clusters is structurally novel.
    # Deliberately a hard partition rather than a weighted blend — a weight would
    # be a number tuned against a vault that is never measured. It also degrades
    # gracefully: if every pair crosses (a fragmented vault) or none does (one
    # giant cluster), the partition is empty and this is pure similarity order.
    def rank(r):
        return (not (bridge_first and r["crosses"]), -r["score"], r["name"].lower())

    results.sort(key=rank)
    return results[:limit]


def cluster_notes(notes, name_index):
    """Wikilink communities over the notes already scanned, plus the graph they came from."""
    neighbors = notes_cluster.adjacency_from_links(notes, name_index)
    labels = notes_cluster.louvain(neighbors)
    return labels, notes_cluster.shape(neighbors, labels)


def resolve_target(spec, notes, name_index):
    by_path = {n["path"]: n for n in notes}
    candidate = os.path.abspath(os.path.expanduser(spec))
    if candidate in by_path:
        return by_path[candidate]
    stem = os.path.splitext(os.path.basename(spec))[0]
    path = name_index.get(stem.lower())
    return by_path.get(path) if path else None


def format_text(target, results, total, include_linked, vault, shape=None):
    name = _printable(target["name"])
    if not results:
        scope = "similar" if include_linked else "unlinked similar"
        return f"No {scope} notes found for '{name}' among {total} notes in {vault}."
    scope = "Similar" if include_linked else "Unlinked similar"
    lines = [f"{scope} to '{name}' ({len(results)} of {total} notes in {vault})"]
    if shape:
        lines.append(notes_cluster.describe_shape(shape))
    lines.append("")
    for r in results:
        rel = _printable(os.path.relpath(r["path"], vault))
        mark = " [linked]" if r["linked"] else ""
        if r["crosses"]:
            mark += f" [bridges cluster {r['cluster']}]"
        lines.append(f"  {r['score']:.4f}  {_printable(r['name'])}{mark}")
        if r["preview"]:
            lines.append(f"          {_printable(r['preview'])}")
        lines.append(f"          {rel}")
    return "\n".join(lines)


def format_json(target, results, include_linked, vault, model, error=None, shape=None):
    return json.dumps(
        {
            "vault": vault,
            "model": model,
            "available": error is None,
            "error": error,
            "unlinked_only": not include_linked,
            "shape": shape,
            "target": {"name": _printable(target["name"]), "path": target["path"]} if target else None,
            "similar": [dict(r, name=_printable(r["name"]), preview=_printable(r["preview"])) for r in results],
        },
        indent=2,
    )


def parse_args(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "positional",
        nargs="*",
        metavar="ARG",
        help="TARGET VAULT — note to compare against, by path or name. "
        "With --index, just VAULT. VAULT may come from $NOTES_VAULT instead",
    )
    parser.add_argument("--index", action="store_true", help="Build or refresh the whole embedding index, then exit")
    parser.add_argument("--rebuild", action="store_true", help="With --index, discard the cache and re-embed everything")
    parser.add_argument("-n", "--limit", type=int, default=10, help="Maximum results to return (default: 10)")
    parser.add_argument("--all", action="store_true", help="Include notes already linked to the target")
    parser.add_argument(
        "--no-bridge",
        action="store_true",
        help="Rank purely by similarity, without floating cluster-crossing pairs above the rest",
    )
    parser.add_argument("--json", action="store_true", help="Emit JSON instead of a text report")
    parser.add_argument(
        "--max-refresh",
        type=int,
        default=50,
        help="Refuse a query needing more than this many embeddings; run --index instead (default: 50)",
    )
    parser.add_argument(
        "--endpoint",
        default=os.environ.get("NOTES_EMBED_URL", notes_embed_client.DEFAULT_ENDPOINT),
        help=f"OpenAI-compatible embeddings base URL (default: $NOTES_EMBED_URL or {notes_embed_client.DEFAULT_ENDPOINT})",
    )
    parser.add_argument(
        "--allow-remote-endpoint",
        action="store_true",
        help="Permit a non-loopback endpoint, sending note text off this machine",
    )
    parser.add_argument(
        "--model",
        default=os.environ.get("NOTES_EMBED_MODEL", notes_embed_client.DEFAULT_MODEL),
        help=f"Embedding model name (default: $NOTES_EMBED_MODEL or {notes_embed_client.DEFAULT_MODEL})",
    )
    parser.add_argument(
        "--exclude",
        action="append",
        metavar="GLOB",
        default=None,
        help="Glob pattern, relative to vault, to exclude from the scan (repeatable)",
    )
    return parser.parse_args(argv)


def run_index(args, vault, notes, embedder):
    cdir = notes_embed_cache.cache_dir(vault)
    cached, dims = ({}, 0) if args.rebuild else notes_embed_cache.load_cache(cdir, args.model)
    stale = len([n for n in notes if (n["path"], n["hash"]) not in cached])
    if stale:
        notes_embed_client.announce(vault, args.endpoint, args.model, stale)
    try:
        dims, embedded = notes_embed_cache.refresh(
            notes, cached, dims, embedder, progress=stale > notes_embed_cache.BATCH_SIZE
        )
    except EmbedUnavailable:
        # Keep what this run already embedded, so a transient failure partway through
        # a multi-minute index isn't thrown away.
        done = [n for n in notes if (n["path"], n["hash"]) in cached]
        if done:
            # dims is still 0 on a first-ever index; take it from what was embedded.
            width = dims or len(next(iter(cached.values())))
            notes_embed_cache.save_cache(cdir, args.model, width, done, cached)
            print(f"notes-similar: saved {len(done)} embeddings before the failure", file=sys.stderr)
        raise
    if dims == 0:
        print(f"notes-similar: nothing to index in {vault}", file=sys.stderr)
        return 1
    notes_embed_cache.save_cache(cdir, args.model, dims, notes, cached)
    print(f"Indexed {len(notes)} notes ({embedded} newly embedded, {dims} dims) in {cdir}")
    return 0


def run_query(args, vault, target_spec, notes, name_index, embedder):
    target = resolve_target(target_spec, notes, name_index)
    if target is None:
        safe_spec = _printable(target_spec)
        print(f"notes-similar: no note matching '{safe_spec}' in {vault}", file=sys.stderr)
        if args.json:
            print(format_json(None, [], args.all, vault, args.model, error=f"no note matching '{safe_spec}'"))
        return 1

    cdir = notes_embed_cache.cache_dir(vault)
    cached, dims = notes_embed_cache.load_cache(cdir, args.model)
    missing = len([n for n in notes if (n["path"], n["hash"]) not in cached])
    if missing > args.max_refresh:
        raise EmbedUnavailable(
            f"{missing} of {len(notes)} notes are unindexed (limit {args.max_refresh}) — run: notes-similar --index"
        )
    if missing:
        notes_embed_client.announce(vault, args.endpoint, args.model, missing)

    dims, embedded = notes_embed_cache.refresh(notes, cached, dims, embedder)
    if embedded:
        notes_embed_cache.save_cache(cdir, args.model, dims, notes, cached)
    clusters, shape = cluster_notes(notes, name_index)
    results = find_similar(
        target, notes, cached, name_index, args.limit, args.all, clusters, not args.no_bridge
    )

    if args.json:
        print(format_json(target, results, args.all, vault, args.model, shape=shape))
    else:
        print(format_text(target, results, len(notes), args.all, vault, shape))
    return 0


def split_positional(args):
    """--index takes VAULT; a query takes TARGET VAULT. Returns (target, vault)."""
    positional = args.positional
    limit = 1 if args.index else 2
    if len(positional) > limit:
        raise ValueError(f"too many arguments: {' '.join(_printable(a) for a in positional[limit:])}")
    if args.index:
        return None, require_vault(positional[0] if positional else None)
    if not positional:
        raise ValueError("a target note is required (or use --index)")
    return positional[0], require_vault(positional[1] if len(positional) > 1 else None)


def check_args(args):
    if args.limit < 1:
        raise ValueError(f"--limit must be at least 1, got {args.limit}")
    if args.max_refresh < 0:
        raise ValueError(f"--max-refresh cannot be negative, got {args.max_refresh}")
    if args.rebuild and not args.index:
        raise ValueError("--rebuild only applies with --index")
    notes_embed_client.validate_endpoint(args.endpoint, args.allow_remote_endpoint)


def main(argv=None):
    args = parse_args(argv)
    try:
        target_spec, vault_spec = split_positional(args)
        check_args(args)
    except ValueError as exc:
        print(f"notes-similar: {exc}", file=sys.stderr)
        return 1

    vault = os.path.abspath(os.path.expanduser(vault_spec))
    if not os.path.isdir(vault):
        print(f"notes-similar: not a directory: {vault}", file=sys.stderr)
        return 1

    notes = scan_vault(vault, args.exclude or [])
    name_index = notes_common.build_name_index([n["path"] for n in notes])

    def embedder(texts):
        return notes_embed_client.embed_batch(texts, args.endpoint, args.model)

    try:
        if args.index:
            return run_index(args, vault, notes, embedder)
        return run_query(args, vault, target_spec, notes, name_index, embedder)
    except EmbedUnavailable as exc:
        # Queries degrade to an empty result so the picker always has valid JSON to
        # parse; --index is an explicit request to do work, so it fails loudly.
        print(f"notes-similar: embeddings unavailable: {exc}", file=sys.stderr)
        if args.index:
            return 1
        if args.json:
            target = resolve_target(target_spec, notes, name_index)
            print(format_json(target, [], args.all, vault, args.model, error=str(exc)))
        else:
            print(f"Embeddings unavailable, no results: {exc}")
        return 0


if __name__ == "__main__":
    sys.exit(main())
