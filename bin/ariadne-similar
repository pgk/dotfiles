#!/usr/bin/env python3

"""Find semantically similar but unlinked notes in a wikilink-based markdown vault."""

import argparse
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import ariadne_cluster
import ariadne_common
import ariadne_duplicates
import ariadne_embed_cache
import ariadne_embed_client
import ariadne_note_text
import ariadne_ranking
import ariadne_search
import ariadne_similar_report

EmbedUnavailable = ariadne_embed_cache.EmbedUnavailable
# Re-exported, not just imported: `find_similar` is the name four suites reach
# it through, so moving it into a module cost no test churn. `rank_against` is
# re-exported only so `run_search` below reads the same way; tests go straight
# to `ariadne_ranking`.
find_similar = ariadne_ranking.find_similar
rank_against = ariadne_ranking.rank_against
_printable = ariadne_common.printable
require_vault = ariadne_common.require_vault


def scan_vault(vault, excludes):
    """One pass per note: read it, hash the embed text, extract its wikilinks."""
    notes = []
    for path in ariadne_common.iter_markdown_files(vault, excludes):
        try:
            with open(path, "r", encoding="utf-8", errors="replace") as f:
                raw = f.read()
        except OSError as exc:
            print(f"warning: skipping unreadable note {_printable(path)}: {_printable(exc)}", file=sys.stderr)
            continue
        name = os.path.splitext(os.path.basename(path))[0]
        chunks = ariadne_note_text.note_chunks(name, raw)
        notes.append(
            {
                "name": name,
                "path": path,
                "hash": ariadne_note_text.content_hash(chunks),
                "links": ariadne_common.extract_links(raw),
                "chunks": chunks,
                "preview": ariadne_note_text.preview_of(chunks[0]),
            }
        )
    return notes


def cluster_notes(notes, name_index):
    """Wikilink communities over the notes already scanned, plus the graph they came from."""
    neighbors = ariadne_cluster.adjacency_from_links(notes, name_index)
    labels = ariadne_cluster.louvain(neighbors)
    return labels, ariadne_cluster.shape(neighbors, labels)


def resolve_target(spec, notes, name_index, *, path_only=False):
    """The scanned note `spec` names -- a path or a bare note name -- or None.

    A path is matched against the path a note was scanned under and, failing
    that, against its realpath: nvim reports a buffer's name with symlinks
    resolved while the vault stays as configured, so in a symlinked vault
    (`~/notes -> ~/Dropbox/notes`) the first form matches nothing at all. The
    realpath pass is skipped unless the cheap one misses.

    `path_only` drops the bare-name fallback for a spec that names a path, and
    `--from` sets it. Without that, a path pointing at a note which was never
    scanned -- one `--exclude` kept out of the run, say -- silently resolves to
    whatever *other* note shares its basename, and the results are then labelled
    with, and exclude, a note the user never named.
    """
    by_path = {n["path"]: n for n in notes}
    candidate = os.path.abspath(os.path.expanduser(spec))
    if candidate in by_path:
        return by_path[candidate]
    looks_like_path = os.sep in spec or (os.path.altsep and os.path.altsep in spec)
    if looks_like_path:
        for note in notes:
            if os.path.realpath(note["path"]) == candidate:
                return note
        if path_only:
            return None
    stem = os.path.splitext(os.path.basename(spec))[0]
    path = name_index.get(stem.lower())
    return by_path.get(path) if path else None


def parse_args(argv):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "positional",
        nargs="*",
        metavar="ARG",
        help="TARGET VAULT — note to compare against, by path or name. "
        "With --index, --duplicates, or --search, just VAULT. VAULT may come from $NOTES_VAULT instead",
    )
    parser.add_argument("--index", action="store_true", help="Build or refresh the whole embedding index, then exit")
    parser.add_argument("--rebuild", action="store_true", help="With --index, discard the cache and re-embed everything")
    ariadne_duplicates.add_arguments(parser)
    ariadne_search.add_arguments(parser)
    parser.add_argument("-n", "--limit", type=int, default=10, help="Maximum results per group, so bridge ranking can return up to twice this; one shared limit under --no-bridge. Under --duplicates it caps the 'possible' band only, never the duplicates. Under a bare --search it caps clusters shown, not hits within one (see --per-cluster); under --search --from it goes back to the per-group meaning (default: 10)")
    parser.add_argument("--all", action="store_true", help="Include notes already linked to the target")
    parser.add_argument(
        "--no-bridge",
        action="store_true",
        help="Rank purely by similarity, without grouping cluster-crossing pairs above the rest",
    )
    parser.add_argument("--json", action="store_true", help="Emit JSON instead of a text report")
    parser.add_argument(
        "--max-refresh",
        type=int,
        default=50,
        help="Refuse a query needing more than this many embeddings; run --index instead (default: 50)",
    )
    parser.add_argument(
        "--endpoint",
        default=os.environ.get("NOTES_EMBED_URL", ariadne_embed_client.DEFAULT_ENDPOINT),
        help=f"OpenAI-compatible embeddings base URL (default: $NOTES_EMBED_URL or {ariadne_embed_client.DEFAULT_ENDPOINT})",
    )
    parser.add_argument(
        "--allow-remote-endpoint",
        action="store_true",
        help="Permit a non-loopback endpoint, sending note text off this machine",
    )
    parser.add_argument(
        "--model",
        default=os.environ.get("NOTES_EMBED_MODEL", ariadne_embed_client.DEFAULT_MODEL),
        help=f"Embedding model name (default: $NOTES_EMBED_MODEL or {ariadne_embed_client.DEFAULT_MODEL})",
    )
    parser.add_argument(
        "--exclude",
        action="append",
        metavar="GLOB",
        default=None,
        help="Glob pattern, relative to vault, to exclude from the scan (repeatable)",
    )
    return parser.parse_args(argv)


def run_index(args, vault, notes, embedder):
    cdir = ariadne_embed_cache.cache_dir(vault)
    cached, dims = ({}, 0) if args.rebuild else ariadne_embed_cache.load_cache(cdir, args.model)
    pending = [n for n in notes if (n["path"], n["hash"]) not in cached]
    stale = len(pending)
    if stale:
        ariadne_embed_client.announce(vault, args.endpoint, args.model, pending)
    try:
        dims, embedded = ariadne_embed_cache.refresh(
            notes, cached, dims, embedder, progress=stale > ariadne_embed_cache.BATCH_SIZE
        )
    except EmbedUnavailable:
        # Keep what this run already embedded, so a transient failure partway through
        # a multi-minute index isn't thrown away.
        done = [n for n in notes if (n["path"], n["hash"]) in cached]
        if done:
            # dims is still 0 on a first-ever index; take it from what was embedded.
            width = dims or ariadne_embed_cache.dims_of(cached)
            ariadne_embed_cache.save_cache(cdir, args.model, width, done, cached)
            print(f"ariadne-similar: saved {len(done)} embeddings before the failure", file=sys.stderr)
        raise
    if dims == 0:
        print(f"ariadne-similar: nothing to index in {vault}", file=sys.stderr)
        return 1
    ariadne_embed_cache.save_cache(cdir, args.model, dims, notes, cached)
    print(f"Indexed {len(notes)} notes ({embedded} newly embedded, {dims} dims) in {cdir}")
    return 0


def load_or_refresh(args, vault, notes, embedder):
    """The cache, topped up in place. Refuses to embed a whole vault behind the user's back."""
    cdir = ariadne_embed_cache.cache_dir(vault)
    cached, dims = ariadne_embed_cache.load_cache(cdir, args.model)
    pending = [n for n in notes if (n["path"], n["hash"]) not in cached]
    missing = len(pending)
    if missing > args.max_refresh:
        raise EmbedUnavailable(
            f"{missing} of {len(notes)} notes are unindexed (limit {args.max_refresh}) — run: ariadne-similar --index"
        )
    if missing:
        ariadne_embed_client.announce(vault, args.endpoint, args.model, pending)

    dims, embedded = ariadne_embed_cache.refresh(notes, cached, dims, embedder)
    if embedded:
        ariadne_embed_cache.save_cache(cdir, args.model, dims, notes, cached)
    return cached


def report_missing_note(args, spec, vault, passage=None):
    """Exit status for a note spec that names nothing, reported both ways.

    Shared by the two modes that resolve one: a whole-note query and
    `--search --from`. They differ only in `passage`, which distinguishes the
    two JSON shapes for the reader.
    """
    safe_spec = _printable(spec)
    print(f"ariadne-similar: no note matching '{safe_spec}' in {vault}", file=sys.stderr)
    if args.json:
        print(ariadne_similar_report.format_json(
            None, [], args.all, vault, args.model,
            error=f"no note matching '{safe_spec}'", passage=passage))
    return 1


def run_query(args, vault, target_spec, notes, name_index, embedder):
    target = resolve_target(target_spec, notes, name_index)
    if target is None:
        return report_missing_note(args, target_spec, vault)

    cached = load_or_refresh(args, vault, notes, embedder)
    clusters, shape = cluster_notes(notes, name_index)
    results = find_similar(
        target, notes, cached, name_index, args.limit, args.all,
        clusters=clusters, bridge_first=not args.no_bridge,
    )

    if args.json:
        print(ariadne_similar_report.format_json(target, results, args.all, vault, args.model, shape=shape))
    else:
        print(
            ariadne_similar_report.format_text(
                target, results, len(notes), args.all, vault, shape, grouped=not args.no_bridge
            )
        )
    return 0


def announce_egress(args, origin):
    """Name what is about to leave the machine, to the field.

    Under `--from` that is a passage out of a note rather than a typed phrase,
    and the note's own name goes with it whenever it carries words -- minus a
    leading Folgezettel id, which `embedded_head` drops before the query is
    built. The notice says so rather than saying "name", which would claim the
    id was sent, or "title", which a reader could take to mean a `#` heading
    when what is sent is the filename.

    The id is dropped from a *query*; a note whose name is nothing but an id
    still has that id embedded on the document side, where `note_chunks` heads
    a chunk unconditionally. So this is not an "ids never leave" guarantee, and
    the notice does not offer one -- such a note reaches `informative_name` as
    a bare id and is reported as a passage alone.
    """
    if origin is None:
        sending = "your search phrase"
    elif ariadne_note_text.embedded_head(origin["name"]):
        sending = "your selected passage and its note's name without its id"
    else:
        sending = "your selected passage"
    print(
        f"ariadne-similar: sending {sending} to "
        f"{ariadne_embed_client.safe_url(args.endpoint)} ({_printable(args.model)})",
        file=sys.stderr,
    )


def run_search(args, vault, notes, name_index, embedder):
    origin = None
    if args.from_note is not None:
        origin = resolve_target(args.from_note, notes, name_index, path_only=True)
        if origin is None:
            return report_missing_note(args, args.from_note, vault, passage=args.search)

    cached = load_or_refresh(args, vault, notes, embedder)
    clusters, shape = cluster_notes(notes, name_index)
    announce_egress(args, origin)
    query_vecs = embedder(ariadne_search.query_texts(
        args.search, lifted=origin is not None,
        name=origin["name"] if origin is not None else None,
    ))
    if cached:
        dims = ariadne_embed_cache.dims_of(cached)
        if len(query_vecs[0]) != dims:
            raise EmbedUnavailable(
                f"query embedding is {len(query_vecs[0])} dims but the index is {dims} — re-run with --rebuild"
            )
    if origin is None:
        return ariadne_search.run(args, vault, notes, cached, clusters, shape, query_vecs[0])

    # With --from the query has a home note, so it is ranked exactly as a
    # whole-note query is -- see PLAN-0009 question 4.
    results = rank_against(
        query_vecs, origin, notes, cached, name_index, args.limit, args.all,
        clusters=clusters, bridge_first=not args.no_bridge,
    )
    if args.json:
        print(ariadne_similar_report.format_json(
            origin, results, args.all, vault, args.model, shape=shape, passage=args.search))
    else:
        print(ariadne_similar_report.format_text(
            origin, results, len(notes), args.all, vault, shape,
            grouped=not args.no_bridge, passage=args.search))
    return 0


def split_positional(args):
    """--index, --duplicates and --search take VAULT; a query takes TARGET VAULT. Returns (target, vault)."""
    positional = args.positional
    vault_only = args.index or args.duplicates or args.search is not None
    limit = 1 if vault_only else 2
    if len(positional) > limit:
        raise ValueError(f"too many arguments: {' '.join(_printable(a) for a in positional[limit:])}")
    if vault_only:
        return None, require_vault(positional[0] if positional else None)
    if not positional:
        raise ValueError("a target note is required (or use --index)")
    return positional[0], require_vault(positional[1] if len(positional) > 1 else None)


def check_args(args):
    if args.limit < 1:
        raise ValueError(f"--limit must be at least 1, got {args.limit}")
    if args.max_refresh < 0:
        raise ValueError(f"--max-refresh cannot be negative, got {args.max_refresh}")
    if args.rebuild and not args.index:
        raise ValueError("--rebuild only applies with --index")
    modes = [("--index", args.index), ("--duplicates", args.duplicates), ("--search", args.search is not None)]
    active = [name for name, on in modes if on]
    if len(active) > 1:
        joined = ", ".join(active[:-1]) + " and " + active[-1]
        raise ValueError(f"{joined} are separate modes; run them one at a time")
    # Refused rather than ignored: both shape a single note's result list, and
    # neither --duplicates nor --search has a target note for them to mean
    # anything about.
    # --search --from does have a target note, so both mean something there; it
    # is a bare --search, ranking a phrase that belongs nowhere, that does not.
    for flag, on in (("--all", args.all), ("--no-bridge", args.no_bridge)):
        if on and (args.duplicates or (args.search is not None and args.from_note is None)):
            raise ValueError(
                f"{flag} applies to a query, not to --duplicates or a --search without --from"
            )
    ariadne_duplicates.check_arguments(args)
    ariadne_search.check_arguments(args)
    ariadne_embed_client.validate_endpoint(args.endpoint, args.allow_remote_endpoint)


def main(argv=None):
    args = parse_args(argv)
    try:
        target_spec, vault_spec = split_positional(args)
        check_args(args)
    except ValueError as exc:
        print(f"ariadne-similar: {exc}", file=sys.stderr)
        return 1

    vault = os.path.abspath(os.path.expanduser(vault_spec))
    if not os.path.isdir(vault):
        print(f"ariadne-similar: not a directory: {vault}", file=sys.stderr)
        return 1

    notes = scan_vault(vault, args.exclude or [])
    name_index = ariadne_common.build_name_index([n["path"] for n in notes])

    def embedder(texts):
        return ariadne_embed_client.embed_batch(texts, args.endpoint, args.model)

    try:
        if args.index:
            return run_index(args, vault, notes, embedder)
        if args.duplicates:
            cached = load_or_refresh(args, vault, notes, embedder)
            return ariadne_duplicates.run(args, vault, notes, cached)
        if args.search is not None:
            return run_search(args, vault, notes, name_index, embedder)
        return run_query(args, vault, target_spec, notes, name_index, embedder)
    except EmbedUnavailable as exc:
        # Queries degrade to an empty result so the picker always has valid JSON to
        # parse; --index is an explicit request to do work, so it fails loudly.
        print(f"ariadne-similar: embeddings unavailable: {exc}", file=sys.stderr)
        if args.index:
            return 1
        if args.json and args.duplicates:
            ariadne_duplicates.report_unavailable(args, vault, len(notes), str(exc))
        elif args.json and args.search is not None and args.from_note is None:
            ariadne_search.report_unavailable(args, vault, len(notes), str(exc))
        elif args.json:
            # --search --from reports in the whole-note shape, so its failure has
            # to as well: the picker reading it indexes `similar`, not `groups`.
            spec = args.from_note if args.from_note is not None else target_spec
            target = resolve_target(spec, notes, name_index)
            print(ariadne_similar_report.format_json(
                target, [], args.all, vault, args.model, error=str(exc), passage=args.search))
        else:
            print(f"Embeddings unavailable, no results: {exc}")
        return 0


if __name__ == "__main__":
    sys.exit(main())
